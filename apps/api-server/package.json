    "@ts-template/tsconfig": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.8",
    "@types/pg": "^8.11.14",
    "drizzle-kit": "^0.30.6",
    "jest": "^29.7.0",
    "typescript": "^5.8.2"
  }
