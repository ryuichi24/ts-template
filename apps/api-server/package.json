  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "nest start --watch --env-file='.env.local'",
    "build": "nest build",
    "dev:db:pg": "docker-compose --file='docker-compose.dev.yml' --env-file='.env.local' up",
    "gen:mdl": "nest generate module --",
    "gen:ctrl": "nest generate controller --",
    "gen:srvs": "nest generate service --",
    "gen:proj": "nest new --",
    "gen:db:migrate": "node ./scripts/generate-db-migration.mjs $npm_config_name",
    "test": "jest --config jest-config.ts",
    "test:cov": "jest --coverage --config jest-config.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.15.2",
