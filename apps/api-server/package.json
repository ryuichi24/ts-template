    "@nestjs/platform-express": "^11.0.1",
    "@strapi/client": "^1.1.0",
    "@ts-template/cache": "workspace:*",
    "@ts-template/date-util": "workspace:*",
    "axios": "^1.8.4",
    "better-sqlite3": "^11.9.1",
    "drizzle-orm": "^0.41.0",
    "pg": "^8.15.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/config": "^4.0.1",
    "@nestjs/schematics": "^11.0.0",
