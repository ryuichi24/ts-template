{
  "name": "@ts-template/desktop-main",
  "version": "1.0.0",
  "description": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development pnpm electron:start",
    "build": "node scripts/build-prod.mjs & pnpm copy:assets",
    "electron:start": "dotenv -e ./.env -c local -- electron dist/index.js",
    "copy:assets": "node -e \"const path = require('path'); const source = path.resolve('src', 'assets'); const dest = path.resolve('dist', 'assets'); const fileSystemUtl = require('@ts-template/file-system'); fileSystemUtl.symlinkDirIfNotExist(source, dest);\""
  },
  "type": "module",
  "devDependencies": {
    "@ts-template/type-util": "workspace:*",
    "@ts-template/desktop-background-server": "workspace:*",
    "@ts-template/electron-app-protocol": "workspace:*",
    "@ts-template/process-event-emitter": "workspace:*",
    "@ts-template/file-system": "workspace:*",
    "@ts-template/logger": "workspace:*",
    "@ts-template/node-js-ctx": "workspace:*",
    "@ts-template/tsconfig": "workspace:*",
    "@types/node": "^22.13.8",
    "cross-env": "^7.0.3",
    "electron": "^34.3.1",
    "electron-squirrel-startup": "^1.0.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2",
    "dotenv-cli": "^8.0.0"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "electron-log": "^5.3.1",
    "electron-updater": "^6.3.9"
  }
}
