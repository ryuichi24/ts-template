{
    "name": "ts-template",
    "version": "0.0.1",
    "description": "",
    "scripts": {
        "dev": "dotenv -e ./.env -c local -- pnpm dev:desktop",
        "dev:desktop": "turbo run dev --filter={\"./apps/desktop/**/*\"}",
        "build": "turbo run build",
        "release:desktop": "cross-env NODE_ENV=production dotenv -e ./.env -c local -- turbo run release --filter={\"./apps/desktop/**/*\"}",
        "clean": "cle clean . --entries node_modules,.turbo,dist,release",
        "gen:env": "node -e \"const path = require('path'); const src = path.resolve('./.env.example'); const dest = path.resolve('./.env.local'); require('@ts-template/file-system').cpFileIfNotExist(src, dest);\"",
        "postinstall": "pnpm build && pnpm gen:env"
    },
    "devDependencies": {
        "@ts-template/cle": "workspace:*",
        "@ts-template/file-system": "workspace:*",
        "concurrently": "^9.1.2",
        "cross-env": "^7.0.3",
        "dotenv-cli": "^8.0.0",
        "turbo": "^2.4.4"
    },
    "engines": {
        "pnpm": ">=9.2.0",
        "npm": "use pnpm!!!!!",
        "yarn": "use pnpm!!!!!"
    },
    "packageManager": "pnpm@9.2.0"
}