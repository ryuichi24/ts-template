{
    "name": "ts-template",
    "version": "0.0.1",
    "description": "",
    "scripts": {
        "dev": "pnpm dev:desktop",
        "dev:desktop": "turbo run dev --filter=\\{\"./apps/desktop/**/*\"\\}",
        "build": "turbo run build",
        "release:desktop:public": "turbo run release:public --filter=\\{\"./apps/desktop/**/*\"\\}",
        "release:desktop:local": "turbo run release:local --filter=\\{\"./apps/desktop/**/*\"\\}",
        "clean": "cle clean . --entries node_modules,.turbo,dist,release",
        "postinstall": "pnpm build"
    },
    "keywords": [],
    "author": "ts-template",
    "devDependencies": {
        "@ts-template/cle": "workspace:*",
        "concurrently": "^9.1.2",
        "cross-env": "^7.0.3",
        "dotenv-cli": "^8.0.0",
        "turbo": "^2.4.4"
    },
    "engines": {
        "pnpm": ">=9.2.0",
        "npm": "use pnpm!!!!!",
        "yarn": "use pnpm!!!!!"
    },
    "packageManager": "pnpm@9.2.0"
}
